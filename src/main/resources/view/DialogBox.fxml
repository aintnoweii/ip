<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<!--
  One message in the transcript. Both speakers share this file, but the two
  factory methods on DialogBox configure it very differently: a user message
  hides the avatar and lets the label hug its text, while a Nova message shows
  the avatar and lets the label span the window. Padding and spacing come from
  the "message" style class in main.css.
-->
<fx:root alignment="TOP_RIGHT"
         maxWidth="1.7976931348623157E308"
         styleClass="message"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <Label fx:id="dialog" minHeight="-Infinity" text="Label" wrapText="true" />
    <ImageView fx:id="displayPicture"
               fitHeight="34.0"
               fitWidth="34.0"
               pickOnBounds="true"
               preserveRatio="true" />
  </children>
</fx:root>
